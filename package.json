{
  "name": "token-bucket-rate-limiter",
  "version": "1.0.0",
  "description": "Token-bucket rate limiting for Node.js and edge runtimes — zero-config in-memory backend plus optional distributed Upstash Redis backend, with fetch-friendly headers and middleware",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rate-limit",
    "rate-limiting",
    "token-bucket",
    "redis",
    "upstash",
    "429",
    "api",
    "middleware"
  ],
  "author": "Navjot Singh",
  "repository": {
    "type": "git",
    "url": "https://github.com/NavjotSingh-ca/token-bucket-rate-limiter.git"
  },
  "bugs": {
    "url": "https://github.com/NavjotSingh-ca/token-bucket-rate-limiter/issues"
  },
  "homepage": "https://github.com/NavjotSingh-ca/token-bucket-rate-limiter#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0"
  },
  "peerDependenciesMeta": {
    "@upstash/ratelimit": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
